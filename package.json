{
  "name": "timeline-app",
  "version": "0.1.0",
  "description": "An interactive timeline of Islamic history, its scholars, events and dynasties.",
  "author": "Serdar Kilic",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test",
    "desktop:build": "npm run build && node scripts/prepare-desktop.cjs && electron-builder",
    "desktop:run": "npm run build && node scripts/prepare-desktop.cjs && electron ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.serdarkilic.islamichistorytimeline",
    "productName": "Islamic History Timeline",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    }
  }
}